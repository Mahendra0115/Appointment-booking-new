    {
      "name": "13. Get Next Available Day",
      "description": "Checks the selected date and returns the next available appointment date and first available slot when the selected date is full, closed, leave day, non-working day, or consulting time is over.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{patientToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/doctor/{{doctorId}}/next-available?from={{nextAvailableFromDate}}&daysToSearch={{daysToSearch}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doctor",
            "{{doctorId}}",
            "next-available"
          ],
          "query": [
            {
              "key": "from",
              "value": "{{nextAvailableFromDate}}"
            },
            {
              "key": "daysToSearch",
              "value": "{{daysToSearch}}"
            }
          ]
        }
      }
    },
    {
      "name": "14. Get Available Slots",
      "description": "Returns available slots for one doctor on one date after removing booked slots, doctor leave, clinic closures, non-working days, and past slots for today.",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{patientToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/doctor/{{doctorId}}/slots?date={{slotCheckDate}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "doctor",
            "{{doctorId}}",
            "slots"
          ],
          "query": [
            {
              "key": "date",
              "value": "{{slotCheckDate}}"
            }
          ]
        }
      }
    },
